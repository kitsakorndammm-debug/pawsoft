// ตารางที่ระบบเขียนเอง ไม่มีหน้าจอให้ใครแก้

/// ใครแก้อะไร จากค่าอะไรเป็นอะไร
///
/// **เขียนในทรานแซกชันเดียวกับการเปลี่ยนแปลงเสมอ** ซึ่งเป็นเหตุผลที่ `writeAudit`
/// รับ `tx` เป็นพารามิเตอร์ตัวแรกและไม่ใช่ตัวเลือก · บันทึกที่เขียนนอกทรานแซกชันจะรอด
/// จากการ rollback แล้วยืนยันว่ามีการเปลี่ยนแปลงที่ไม่เคยเกิดขึ้นจริง
///
/// **เก็บเฉพาะฟิลด์ที่เปลี่ยนจริง ไม่ใช่ทั้งแถว** · ฟอร์มแก้ไขส่งทุกฟิลด์กลับมาตอนกดบันทึก
/// ฉะนั้น "สิ่งที่ request พูดถึง" คือทั้งฟอร์มเสมอ ไม่ว่าจะมีใครพิมพ์อะไรหรือเปล่า ·
/// เก็บทั้งก้อนแปลว่าทุกแถวหน้าตาเหมือนกันหมด แล้วคนอ่านต้องนั่งไล่เทียบเองว่าอะไรต่าง ·
/// `diffFields()` ใน `kit/audit.ts` เป็นคนตัด และถ้าไม่มีอะไรต่าง ก็ไม่มีแถวเกิดขึ้นเลย
///
/// **`passwordHash` `tokenHash` และเพื่อน ๆ ถูกตัดทิ้งเสมอ** ต่อให้ผู้เรียกส่งมา —
/// ตารางนี้เป็นตารางที่คนเปิดอ่าน · ความลับที่หลุดมาอยู่ตรงนี้คือความลับที่ย้ายจากที่ที่
/// ถูกป้องกันไปอยู่ในที่ที่ถูกอ่าน
model AuditLog {
  id BigInt @id @default(autoincrement())

  /// `user.change-password` — รูป `<โมดูล>.<การกระทำ>` เดียวกับ permission key
  action String @db.VarChar(100)
  module String @db.VarChar(50)

  /// แถวไหนที่ถูกแก้ · null สำหรับการกระทำที่ไม่ได้ผูกกับแถวเดียว
  ///
  /// **ไม่ใช่ FK** — ตารางปลายทางต่างกันไปในแต่ละแถว และแถวที่ถูกลบไปแล้วยังต้องมี
  /// บันทึกอยู่ · FK จะบังคับให้บันทึกหายตามของที่มันบันทึกไว้ ซึ่งกลับหัวกลับหางกับ
  /// เหตุผลที่ตารางนี้มีอยู่
  recordId BigInt? @map("record_id")

  /// ค่าก่อนและหลัง — เฉพาะฟิลด์ที่ต่างกัน · `create` ไม่มี `before` · `delete` ไม่มี `after`
  before Json?
  after  Json?

  /// คนที่สั่ง — **ชี้ `user.id` เสมอ ไม่มีฝั่งเจ้าของสัตว์**
  ///
  /// เพราะบัญชีเจ้าของสัตว์แก้ข้อมูลของคลินิกไม่ได้เลย · วันที่มันทำได้ (แก้ที่อยู่ตัวเอง
  /// จองคิว) จะเป็นคำถามใหม่ว่าบันทึกลงที่นี่หรือลงตารางของมันเอง และคำตอบขึ้นกับว่า
  /// คนที่เปิดอ่านหน้านี้อยากเห็นสองอย่างนั้นปนกันไหม
  userId BigInt @map("user_id")

  /// `WEB` `API` `SYSTEM` `JOB` — ยังไม่มีชั้นไหนรู้จริง จึงเป็น `WEB` ไปก่อน
  source String @default("WEB") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([module, recordId])
  @@index([userId, createdAt])
  @@map("audit_log")
}
