// การชำระเงิน — **สองขั้น: เคาน์เตอร์เก็บ แล้วบัญชียืนยัน**
//
// (ผู้ใช้กำหนด 2026-09-01: "พอรักษาเสร็จก็จะต้องมีการจ่ายเงิน โดยจะมีทั้งเงินสดและโอน
// จะเป็นการสร้างพร้อมเพย์ขึ้นมาเป็นรหัสเฉพาะครั้งตามยอดบิล เก็บหลักฐานโดยการอัปโหลด
// สลิปโดยพนักงานเคาน์เตอร์" · "จะมีบัญชีมายืนยันยอดอีกทีนึงหลังจากที่เคาน์เตอร์ส่งยอด
// แล้ว เป็นระบบ recheck ของคลินิก")
//
// **ลูกค้าจ่ายเองได้ ไม่ใช่แค่เคาน์เตอร์** (ผู้ใช้กำหนด 2026-09-01) — สแกน QR จาก
// หน้าจอตัวเอง แล้วอัปสลิปเอง · `payment.created_by` จึง nullable เหมือน
// `appointment.created_by` และมี `created_by_owner_account_id` คู่กัน
//
// **ทำไมต้องมีตาราง `Invoice` ทั้งที่ `Visit` มีรายการอยู่แล้ว**
//
// เพราะยอดบนใบเสร็จต้อง**หยุดนิ่ง** ณ วินาทีที่ออกใบ · รายการใน `visit_service` และ
// `visit_drug` ยังแก้ได้ตราบใดที่คิวยังไม่ปิด และยอดที่คำนวณสดจากมันจะเปลี่ยนตาม ·
// ใบเสร็จที่ยอดเปลี่ยนได้หลังลูกค้าจ่ายเงินแล้ว คือใบที่กระทบยอดกันไม่ได้
//
// `Invoice.subtotal` จึงเป็นค่าที่**คัดลอกมา** ไม่ใช่ค่าที่ join กลับไปคำนวณ —
// เหตุผลเดียวกับที่ `visit_drug.unit_price` คัดลอกราคามาจาก `drug`

/// สถานะของใบเสร็จ — **เดินทางเดียว ไม่ย้อน**
///
///   DRAFT → AWAITING_VERIFY → VERIFIED
///                 ↓
///             REJECTED (กลับไป DRAFT ได้)
///
/// **`VERIFIED` คือปลายทาง** · หลังจากนั้นแก้อะไรไม่ได้อีกเลย เพราะบัญชียืนยันไปแล้วว่า
/// เงินเข้าครบ · ใบที่ผิดหลังยืนยันต้องออกใบลดหนี้ ไม่ใช่แก้ใบเดิม (ยังไม่ทำในรอบนี้)
enum InvoiceStatus {
  /// เคาน์เตอร์กำลังรับเงิน — ยังเพิ่ม/ลบการจ่ายได้
  DRAFT

  /// เคาน์เตอร์ส่งยอดแล้ว รอบัญชีตรวจ — **ล็อกไม่ให้แก้**
  ///
  /// ล็อกตรงนี้เพราะถ้าแก้ได้ระหว่างรอ บัญชีจะตรวจของที่ไม่ใช่ของที่ส่งมา
  AWAITING_VERIFY

  /// บัญชียืนยันว่ายอดตรง — จบ
  VERIFIED

  /// บัญชีตีกลับ — `rejectReason` บอกว่าเพราะอะไร · กลับไปแก้ที่ `DRAFT` ได้
  REJECTED

  /// ยกเลิกใบ — ออกผิด หรือคิวถูกยกเลิก
  VOID

  @@map("invoice_status")
}

/// ใบเสร็จหนึ่งใบ — **หนึ่งคิวหนึ่งใบที่ยังมีผล** (ผู้ใช้ตัดสิน 2026-09-01)
///
/// partial unique ที่ฐานบังคับกฎนั้น โดยไม่นับใบที่ยกเลิกแล้ว — ดู `visitId` ·
/// คนพาสัตว์สามตัวมาครั้งเดียวได้สามคิวสามใบ จ่ายแยกกัน
model Invoice {
  id BigInt @id @default(autoincrement())

  /// เลขที่ใบเสร็จ — `INV-20260901-0001` · ห้ามซ้ำทั้งตาราง แม้ใบที่ยกเลิกไปแล้ว
  ///
  /// เอากลับมาใช้ซ้ำไม่ได้เด็ดขาด — เลขที่ใบเสร็จไปอยู่ในบัญชีของลูกค้าและของสรรพากร
  code String @unique @db.VarChar(30)

  /// คิวที่ใบนี้เก็บเงิน — **หนึ่งคิวหนึ่งใบ*ที่ยังไม่ถูกยกเลิก***
  ///
  /// **ไม่ใช่ `@unique` เต็ม** (แก้ 2026-09-01 · ผู้ใช้ทักท้วง "ยกเลิกใบเก็บแล้วเปิด
  /// กลับมาไม่ได้")
  ///
  /// unique เต็มแปลว่าใบที่ยกเลิกไปแล้วยังกินที่อยู่ · คิวที่ออกใบผิดจะออกใหม่ไม่ได้
  /// ตลอดกาล ซึ่งเป็นทางตันที่ไม่มีปุ่มไหนพาออกมาได้
  ///
  /// กฎจริงอยู่ที่ partial unique ใน `07-payment.sql`:
  /// ห้ามซ้ำเฉพาะแถวที่ยังไม่ถูกลบและยังไม่ `VOID`
  visitId BigInt @map("visit_id")
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Restrict)

  status InvoiceStatus @default(DRAFT)

  /// ยอดรวมของรายการ ณ วินาทีที่ออกใบ — **คัดลอกมา ไม่ได้คำนวณสด**
  ///
  /// ดู `///` บนหัวไฟล์ · เปลี่ยนได้ตราบที่ยังเป็น `DRAFT` (ออกใบใหม่ทับ) แต่พอส่ง
  /// ให้บัญชีแล้วมันคือตัวเลขที่ทั้งสองฝ่ายตกลงกัน
  subtotal Decimal @db.Decimal(12, 2)

  /// ส่วนลด — **บาท ไม่ใช่เปอร์เซ็นต์**
  ///
  /// เปอร์เซ็นต์ต้องคำนวณกลับเป็นบาทอยู่ดีตอนลงบัญชี และการปัดเศษจะไม่ตรงกันระหว่าง
  /// สองที่ · เก็บผลลัพธ์ที่ตกลงกันจริงไปเลย
  discount Decimal @default(0) @db.Decimal(12, 2)

  /// ยอดที่ต้องจ่ายจริง = `subtotal - discount` — **เก็บซ้ำโดยตั้งใจ**
  ///
  /// คำนวณสดจากสองช่องข้างบนก็ได้ แต่ทุกที่ที่รวมยอดจะต้องจำสูตรเดียวกัน · เก็บไว้
  /// แล้วให้ CHECK ที่ฐานบังคับว่ามันตรงกับสูตรเสมอ (ดู `07-payment.sql`)
  total Decimal @db.Decimal(12, 2)

  /// รวมที่รับมาแล้ว — อัปเดตทุกครั้งที่เพิ่ม/ลบการจ่าย
  paid Decimal @default(0) @db.Decimal(12, 2)

  note String? @db.VarChar(1000)

  // ---- เคาน์เตอร์ส่งยอด ----

  /// เวลาที่เคาน์เตอร์กดส่ง — คู่ At/By บังคับด้วย CHECK
  submittedAt DateTime? @map("submitted_at")
  submittedBy BigInt?   @map("submitted_by")

  // ---- บัญชีตรวจ ----

  /// **คนยืนยันต้องไม่ใช่คนส่ง** — บังคับด้วย CHECK ที่ฐาน
  ///
  /// นี่คือหัวใจของ recheck · ให้คนเดียวทำทั้งสองขั้นได้เมื่อไหร่ การตรวจสอบก็ไม่มี
  /// ความหมาย · คลินิกที่เจ้าของทำเองคนเดียวจะติดกฎนี้ ซึ่งถูกแล้ว — เขาต้องรู้ตัวว่า
  /// กำลังข้ามขั้นตอนที่ตั้งใจให้มีสองคน
  verifiedAt DateTime? @map("verified_at")
  verifiedBy BigInt?   @map("verified_by")

  /// เหตุผลที่ตีกลับ — คู่กับ `status = REJECTED` บังคับด้วย CHECK
  rejectReason String? @map("reject_reason") @db.VarChar(500)

  payments Payment[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy BigInt?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy BigInt    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy BigInt    @map("updated_by")

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("invoice")
}

/// วิธีจ่าย
///
/// **`TRANSFER` กับ `PROMPTPAY` แยกกัน** ทั้งที่เงินเข้าบัญชีเดียวกัน — อันหลังมี QR
/// ที่ระบบออกให้และมีเลขอ้างอิงของตัวเอง ส่วนอันแรกคือลูกค้าโอนเองจากที่ไหนก็ได้ ·
/// รวมกันแปลว่าตอบไม่ได้ว่า QR ที่ออกไปมีคนสแกนจริงกี่ใบ
enum PaymentMethod {
  CASH
  PROMPTPAY
  TRANSFER
  CARD

  @@map("payment_method")
}

/// การจ่ายหนึ่งครั้ง
///
/// **ตอนนี้บังคับหนึ่งใบหนึ่งแถว** (ผู้ใช้ตัดสิน 2026-09-01) — กฎอยู่ที่
/// `addPayment` ไม่ได้อยู่ที่ฐาน
///
/// ตารางยังรองรับหลายแถวโดยตั้งใจ: วันที่คลินิกอยากให้จ่ายสดครึ่งโอนครึ่ง จะถอด
/// เงื่อนไขในโค้ดออกได้เลยโดยไม่ต้อง migrate · ใส่ unique ที่ฐานตอนนี้แปลว่าวันนั้น
/// ต้องแก้โครงตารางที่มีข้อมูลจริงอยู่แล้ว
model Payment {
  id BigInt @id @default(autoincrement())

  invoiceId BigInt  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method PaymentMethod
  amount Decimal @db.Decimal(12, 2)

  /// เวลาที่รับเงินจริง — **ไม่ใช่ `createdAt`**
  ///
  /// พนักงานบันทึกย้อนหลังได้ (ลูกค้าโอนตอนเช้า มาบันทึกตอนบ่าย) · `createdAt` บอกว่า
  /// พิมพ์เข้าระบบตอนไหน ซึ่งเป็นคนละคำถาม
  receivedAt DateTime @default(now()) @map("received_at")

  /// เลขอ้างอิงจากธนาคาร — ตัวที่เอาไปกระทบยอดกับ statement
  reference String? @db.VarChar(100)

  /// รหัสอ้างอิงของ QR ที่ระบบออกให้ครั้งนี้ — เฉพาะ `PROMPTPAY`
  ///
  /// **ไม่เก็บ payload ของ QR ทั้งก้อน** — มันคำนวณกลับได้จากเบอร์พร้อมเพย์กับยอด
  /// และเก็บไว้แปลว่ามีสองที่ที่ต้องตรงกัน
  promptpayRef String? @map("promptpay_ref") @db.VarChar(50)

  /// สลิปที่แนบ — **ไม่ใช่ FK ไปตารางไฟล์ เพราะยังไม่มีตารางนั้น**
  ///
  /// เก็บ path ที่ชี้เข้า `UPLOAD_DIR` · ชื่อไฟล์ระบบตั้งเอง ไม่ใช้ชื่อที่ลูกค้าส่งมา
  /// (ดู `payment.storage.ts`)
  slipPath String? @map("slip_path") @db.VarChar(500)

  /// sha256 ของไฟล์ — **กันสลิปใบเดียวถูกใช้ซ้ำหลายใบเสร็จ**
  ///
  /// เป็นการฉ้อโกงที่เกิดจริงในคลินิก: โอนครั้งเดียวแล้วเอาสลิปเดิมไปแนบหลายใบ ·
  /// unique เฉพาะแถวที่มีสลิป (partial) เพราะจ่ายสดไม่มีสลิป
  slipHash String? @map("slip_hash") @db.VarChar(64)

  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  /**
   * **nullable เพราะลูกค้าแนบสลิปเองได้** (ผู้ใช้กำหนด 2026-09-01: "ลูกค้ากดที่หน้าจอ
   * ตัวเองด้วย แล้วสแกน QR อัปโหลดหลักฐานเองได้")
   *
   * รูปเดียวกับ `Appointment.createdBy` — ตารางที่คนนอกเขียนได้ต้องตอบได้ว่าใครเขียน
   * โดยไม่โกหกว่าเป็นพนักงาน · CHECK บังคับว่าต้องมีฝั่งใดฝั่งหนึ่ง ไม่ใช่ทั้งคู่
   */
  createdBy BigInt? @map("created_by")

  createdByOwnerAccountId BigInt?          @map("created_by_owner_account_id")
  createdByOwnerAccount   PetOwnerAccount? @relation(fields: [createdByOwnerAccountId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  @@index([invoiceId])
  @@index([method, receivedAt])
  @@map("payment")
}
