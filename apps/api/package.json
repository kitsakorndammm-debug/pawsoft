{
  "name": "@pawsoft/api",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "bun prisma/push.ts",
    "db:reset": "bun prisma/push.ts --force-reset",
    "db:studio": "prisma studio",
    "db:push:test": "bun prisma/push-test-db.ts test",
    "db:push:e2e": "bun prisma/push-test-db.ts e2e",
    "db:seed": "bun prisma/seed/index.ts",
    "db:seed:e2e": "bun prisma/seed/run-e2e-seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "elysia": "^1.4.29",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.33",
    "@types/bun": "^1.2.24",
    "@types/pg": "^8.15.6",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
